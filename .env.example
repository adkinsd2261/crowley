# Copy to .env and add your key (never commit .env)
OPENAI_API_KEY=sk-proj-...

# Bearer token for ChatGPT Custom GPT Actions (/api/actions/* only)
CROWLEY_ACTION_KEY=

# Optional: stable Cloudflare named tunnel hostname (see docs/CHATGPT_SETUP.md)
# Example operator hostname: api.javlin.ai
# CLOUDFLARE_TUNNEL_HOSTNAME=api.yourdomain.com
