# Named Cloudflare Tunnel for Crowley ChatGPT Actions (production-style).
#
# Setup (once):
#   1. cloudflared tunnel login
#   2. cloudflared tunnel create crowley-chatgpt
#   3. Copy this file to cloudflared/config.yml
#   4. Replace TUNNEL_ID and credentials-file path with output from step 2
#   5. cloudflared tunnel route dns crowley-chatgpt crowley.YOUR_DOMAIN.com
#   6. Set in .env: CLOUDFLARE_TUNNEL_HOSTNAME=crowley.YOUR_DOMAIN.com
#
# Start: ./scripts/start_chatgpt_bridge.sh --named

tunnel: TUNNEL_ID
credentials-file: .crowley/cloudflared/TUNNEL_ID.json

ingress:
  - hostname: crowley.YOUR_DOMAIN.com
    service: http://127.0.0.1:8765
  - service: http_status:404
